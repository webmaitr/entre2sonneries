  </div>
  <Navigation />
  
</header>

<style>
  @layer components {
    header {
      border-bottom: 1px solid var(--color-border);
      padding: 10px;
      .social-links {
        justify-content: right;
        margin-bottom: var(--space-md);
        border-bottom: 1px solid var(--color-border);
      }
      .sonneries {
        margin-bottom: var(--space-md);
        flex: 1;
        display: flex;
        gap: var(--space-md);
        justify-content: space-around;
        max-width: 400px;
        margin-left: auto;
        margin-right: auto;
        .site-title {
          p {
            font-size: var(--text-2xl);
            text-align: center;
          }
          p:last-of-type {
            font-size: var(--text-xl)
          }
        }
        a {
          color: var(--color-text-primary);
        }
        svg {
          height: 2.5rem;
          width: auto;
          max-width: 100%;
        }
      }
      .hamburger {
        margin-left: auto;
      }
    }
  }
</style>